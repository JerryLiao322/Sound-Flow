{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sound Flow",
  "version": "../package.json",
  "identifier": "io.github.jerryliao322.soundflow",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Sound Flow",
        "width": 1320,
        "height": 900,
        "minWidth": 780,
        "minHeight": 560,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#0a0a0a",
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Sound Flow",
    "copyright": "© 2026 Sound Flow",
    "category": "Utility",
    "shortDescription": "按应用把声音分别送到不同的输出设备",
    "longDescription": "Sound Flow 用连线的方式管理每个应用的声音：把 Spotify 送到音响、游戏和语音送到耳机，并分别调节应用音量与设备音量。",
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      }
    }
  }
}
